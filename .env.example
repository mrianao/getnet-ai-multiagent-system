# ---------- LLM (any OpenAI-compatible endpoint) ----------
# Default: local Ollama (free). On the host: `ollama pull llama3.2:3b`
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
# In docker compose the default is http://host.docker.internal:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=500

# Optional free cloud alternative (Groq free tier, no billing):
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=<your-groq-key>

# Anthropic Claude (official SDK; LLM_BASE_URL is ignored):
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_API_KEY=<your-anthropic-key>

# ---------- RAG ----------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=4
RAG_MIN_SCORE=0.25
CHUNK_SIZE=900
CHUNK_OVERLAP=150
AUTO_INGEST=true

# ---------- Web search ----------
# Optional (free tier): improves general web search. Leave empty to use DuckDuckGo Instant Answer + Wikipedia.
TAVILY_API_KEY=
HTTP_TIMEOUT_S=10

# ---------- App ----------
LOG_LEVEL=INFO

# ---------- State, auth & conversations ----------
# SQLite file (token hashes, conversations, tickets, traces). In Docker: /app/state/app.db (volume).
# STATE_DB_PATH=.cache/state/app.db
HISTORY_WINDOW=6
TOKEN_TTL_HOURS=168

# ---------- Retrieval & grounding (values chosen with eval/retrieval_eval.py) ----------
RAG_DEDUPE=true
RAG_LEXICAL_GATE=0.10
GROUNDING_SIM_THRESHOLD=0.5
REPLAN_BUDGET_S=150
